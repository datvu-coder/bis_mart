# Template for /opt/apps/bismart/.env on the VPS.
# Referenced by bismart-vps-compose.example.yml's `env_file`.

# Must point at the bismart-postgres container over the shared Docker
# network configured in bismart-vps-compose.example.yml.
DATABASE_URL=postgresql://bismart:BismartPassword2024@bismart-postgres:5432/bismart

# JWT signing secret — set a real random value in production, do not reuse
# the dev default from app.py.
SECRET_KEY=

PORT=8000
